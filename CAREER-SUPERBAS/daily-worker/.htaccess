# ===================================================
# .htaccess untuk PT. BAROKAH AMANAH SENTOSA (cPanel)
# ===================================================
# Clean URL + Tab Routing untuk Daily Worker Dashboard
# ===================================================

# MIME Types - agar file JS/CSS di-serve dengan benar
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. 301 Redirect: /page.html → /page (SEO & backward compat)
  RewriteCond %{THE_REQUEST} \s/daily-worker/([^.]+)\.html[\s?] [NC]
  RewriteRule ^ /daily-worker/%1 [R=301,L]

  # 2. Jangan proses file/folder yang sudah ada
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # 3. Coba serve sebagai .html dulu (login, admin, dll)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # 4. Dashboard tab routes → serve dashboard-new.html
  #    (berkas, chat, absensi, slipgaji, linkgaji, rekening, dll)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/daily-worker/$
  RewriteRule . dashboard-new.html [L]

  # Protect uploads — only allow image/pdf access
  RewriteCond %{REQUEST_URI} /uploads/ [NC]
  RewriteCond %{REQUEST_URI} !\.(jpg|jpeg|png|pdf)$ [NC]
  RewriteRule .* - [F,L]
</IfModule>
