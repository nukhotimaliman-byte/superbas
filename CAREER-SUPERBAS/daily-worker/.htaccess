# ===================================================
# .htaccess untuk PT. BAROKAH AMANAH SENTOSA (cPanel)
# ===================================================
# Catatan: File ini kompatibel dengan shared hosting cPanel
# Jika masih error 500, coba hapus file .htaccess ini.
# Website tetap bisa jalan tanpa file ini.
# ===================================================

# MIME Types - agar file JS/CSS di-serve dengan benar
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Skip real files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Dashboard clean URLs → route to dashboard-new.html
  RewriteRule ^(berkas|absensi|slipgaji|linkgaji|rekening|gantirek|aduan|idcard|lokasi|chat|lainnya|settings|home)$ dashboard-new.html [L,QSA]

  # Skip index/root
  RewriteCond %{REQUEST_URI} !^/$

  # All other 404s → app.html (React SPA)
  RewriteRule ^ app.html [L]

  # Protect uploads
  RewriteCond %{REQUEST_URI} /uploads/ [NC]
  RewriteCond %{REQUEST_URI} !\.(jpg|jpeg|png|pdf)$ [NC]
  RewriteRule .* - [F,L]
</IfModule>
