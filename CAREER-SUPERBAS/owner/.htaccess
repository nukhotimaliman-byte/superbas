# Block config.php and json files
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>

<FilesMatch "\.(json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Clean URL + Block data directory
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 301 Redirect: /page.html → /page
    RewriteCond %{THE_REQUEST} \s/owner/([^.]+)\.html[\s?] [NC]
    RewriteRule ^ /owner/%1 [R=301,L]

    # Internal rewrite: /page → /page.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]

    # Block direct access to data directory
    RewriteRule ^data/ - [F,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
