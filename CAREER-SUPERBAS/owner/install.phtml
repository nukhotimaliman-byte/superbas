<?php
/**
 * One-time installer for BAS Owner Command Center PHP files.
 * Downloads from GitHub and extracts owner/ PHP + htaccess files.
 * Self-deletes after successful installation.
 */
header('Content-Type: text/plain; charset=utf-8');
echo "=== BAS Owner PHP Installer ===\n\n";

$repoZip = 'https://github.com/nukhotimaliman-byte/superbas/archive/refs/heads/main.zip';
$tmpZip  = __DIR__ . '/tmp-owner-install.zip';

// Download from GitHub
echo "Downloading from GitHub...\n";
$ch = curl_init($repoZip);
curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
curl_setopt($ch, CURLOPT_TIMEOUT, 60);
$data = curl_exec($ch);
$httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
curl_close($ch);

if ($httpCode !== 200 || !$data) {
    die("FAIL: Download gagal (HTTP $httpCode)\n");
}

file_put_contents($tmpZip, $data);
echo "Downloaded: " . round(filesize($tmpZip)/1024) . " KB\n\n";

// Extract owner PHP files
$zip = new ZipArchive;
if ($zip->open($tmpZip) !== TRUE) {
    die("FAIL: Gagal buka ZIP\n");
}

$prefix = 'superbas-main/CAREER-SUPERBAS/owner/';
$count = 0;

for ($i = 0; $i < $zip->numFiles; $i++) {
    $name = $zip->getNameIndex($i);
    if (strpos($name, $prefix) !== 0) continue;

    $rel = substr($name, strlen($prefix));
    if (empty($rel) || substr($rel, -1) === '/') continue;

    // Only extract PHP and htaccess files
    if (!preg_match('/\.(php|htaccess)$/i', $rel)) continue;
    // Skip this installer
    if ($rel === 'install.phtml') continue;

    $dest = __DIR__ . '/' . $rel;
    $dir  = dirname($dest);
    if (!is_dir($dir)) mkdir($dir, 0755, true);

    $content = $zip->getFromIndex($i);
    if ($content === false) {
        echo "FAIL: $rel\n";
        continue;
    }

    file_put_contents($dest, $content);
    echo "OK: $rel\n";
    $count++;
}

$zip->close();
@unlink($tmpZip);

// Create data directory
if (!is_dir(__DIR__ . '/data')) {
    mkdir(__DIR__ . '/data', 0755, true);
    echo "OK: data/ directory created\n";
}

echo "\n=== Done: $count PHP files installed ===\n";

// Self-delete
@unlink(__FILE__);
echo "Installer removed.\n";
