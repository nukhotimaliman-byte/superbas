# Data KalSul — SPA routing
# Built files are in dist/ but referenced as /data-kalsul/assets/

RewriteEngine On
RewriteBase /data-kalsul/

# Don't rewrite API requests
RewriteRule ^api/ - [L]

# Rewrite assets/ to dist/assets/ (Vite build output)
RewriteRule ^assets/(.+)$ dist/assets/$1 [L]

# Serve dist/ files directly
RewriteRule ^dist/ - [L]

# Everything else → SPA (dist/index.html)
RewriteCond %{REQUEST_URI} !^/data-kalsul/api/
RewriteCond %{REQUEST_URI} !^/data-kalsul/dist/
RewriteCond %{REQUEST_URI} !^/data-kalsul/assets/
RewriteRule ^(.*)$ dist/index.html [L]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

Options -Indexes
