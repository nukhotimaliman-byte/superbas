# Data KalSul — SPA routing
# Serve built files from dist/ subfolder

RewriteEngine On
RewriteBase /data-kalsul/

# Don't rewrite API requests
RewriteRule ^api/ - [L]

# Serve files from dist/ if they exist there
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/data-kalsul/dist%{REQUEST_URI} -f
RewriteRule ^(.+)$ dist/$1 [L]

# Serve assets from dist/assets
RewriteRule ^assets/(.+)$ dist/assets/$1 [L]

# SPA fallback — route everything else to dist/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/data-kalsul/api/
RewriteCond %{REQUEST_URI} !^/data-kalsul/dist/
RewriteRule . dist/index.html [L]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Disable directory listing
Options -Indexes
